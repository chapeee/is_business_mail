{
  "name": "@myselfraj/is-business-mail",
  "version": "1.0.16",
  "description": "Checks if an email is a business email against a list of 16,000+ public, free and disposable email providers.",
  "main": "dist/is-business-mail.js",
  "types": "dist/is-business-mail.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.d.ts"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "webpack",
    "test": "npm run build && node --test test/index.test.js",
    "prepublishOnly": "npm run clean && npm run build && node --test test/index.test.js",
    "publish-ver": "npm run clean && npm run build && npm publish --registry http://localhost:4873",
    "postbuild": "node rename-declarations.js"
  },
  "author": "grapdevs",
  "license": "ISC",
  "devDependencies": {
    "rimraf": "^5.0.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chapeee/is_business_mail"
  },
  "homepage": "https://github.com/chapeee/is_business_mail#readme",
  "keywords": [
    "verify-emails",
    "verify",
    "business-emails",
    "email-validation",
    "public-email-list"
  ]
}
